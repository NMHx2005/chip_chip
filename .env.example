# Public site URL — used for metadataBase, hreflang and sitemap.
NEXT_PUBLIC_SITE_URL=https://projectchipchip.org

# Supabase (phase 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Salt for the comment rate limiter's IP digest. Falls back to the service role
# key when unset, which works but means rotating that key resets every counter.
COMMENT_IP_SALT=

# How many proxies sit in front of the app. The rate limiter reads the
# forwarding chain from the right, and skipping the wrong number of hops lets a
# bot mint a fresh identity per request. Vercel, or one nginx: 1. A CDN in
# front of that: 2. App exposed directly: 0.
TRUSTED_PROXY_HOPS=1
